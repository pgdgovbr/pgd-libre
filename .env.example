# App
ENVIRONMENT=development
APP_URL=http://localhost:8000
# generate: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql+psycopg://pgdlibre:pgdlibre@localhost:5432/pgdlibre

# Auth — Google OAuth (dev) — https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:8000/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth — Gov.br OIDC (prod) — https://manual.acesso.gov.br/
# Redirect URI: https://seu-dominio.gov.br/auth/callback/govbr
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
GOVBR_ISSUER=https://sso.acesso.gov.br

# Email (smtp4dev roda na porta 1025 via docker compose)
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=pgd-libre@example.gov.br
MAIL_STARTTLS=false
MAIL_SSL_TLS=false
